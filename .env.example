# LLM: "anthropic" (default) or "openai"
LLM_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...
# Optional: SDK v5 uses data source for queries (auto-resolved from database if omitted)
# NOTION_DATA_SOURCE_ID=...

# Optional Notion / behavior
# NOTION_PROPERTY_STUDY_THEMES=Study themes
# NOTION_STUDY_THEMES_MAX_TOPICS=12
# NOTION_STATUS_APPLIED=Applied
# Match your Notion status names (defaults fit common trackers):
# NOTION_STATUS_DISCOVERED=Not applied
# NOTION_STATUS_SKIP=Rejected
# NOTION_STATUS_PACKET_READY=In progress
# NOTION_PROPERTY_SCORE=Score
# NOTION_PROPERTY_MATCH=Match
# NOTION_PROPERTY_SOURCE=Source
# NOTION_PROPERTY_MATCH_REASONS=Match reasons
# NOTION_PROPERTY_PACKET_FOLDER=Packet folder
# TRACK_JOB_DEBUG=1

# --- Automation (npm run copilot) ---
# COPILOT_NOTIFY=1
# COPILOT_INBOX=1
# INGEST_INTERVAL_MINUTES=360
# INBOX_INTERVAL_MINUTES=15
# AUTO_PACKET=1
# AUTO_PACKET_ON_INGEST=1
# AUTO_PACKET_MIN_SCORE=75
# AUTO_PACKET_BATCH=3
# INGEST_MIN_SCORE=40

# Auto-apply (off by default — see docs/auto-apply.md)
# AUTO_APPLY=0
# AUTO_APPLY_DRY_RUN=1
# AUTO_APPLY_LIVE=0
# AUTO_APPLY_MIN_SCORE=75
# AUTO_APPLY_BATCH=2
# AUTO_APPLY_ATS=greenhouse

# Job ingest sources
# GREENHOUSE_BOARDS=airbnb
# LEVER_SITES=netflix
# ASHBY_BOARDS=your-company
# HIMALAYAS_ENABLED=1
# HIMALAYAS_SEARCH_QUERY=software engineer remote
# HIMALAYAS_PAGES=2
# REMOTEOK_ENABLED=1
# RSS_URLS=https://example.com/jobs.rss
# SCRAPE_URLS=https://company.com/careers
# SCRAPE_MAX_LINKS=15
# INGEST_MAX_JOBS=50
# INGEST_PER_SOURCE=25
# INGEST_LLM_DELAY_MS=300
# Resolve Himalayas/RemoteOK links to Greenhouse/Lever/Ashby during ingest (default on).
# Himalayas HTML is Cloudflare-protected; resolution uses the search API + ATS board title match.
# RESOLVE_ATS_URLS=1
# RESOLVE_ATS_TIMEOUT_MS=10000
# RESOLVE_ATS_MIN_DELAY_MS=750
# For reliable Himalayas → ATS mapping, configure known board slugs:
# GREENHOUSE_BOARDS=grafanalabs,bloomerang,pindropsecurity
# ASHBY_BOARDS=clipboard,mercor,g2i,truelogic
# LLM_SCORE_MAX_TOKENS=1024

# Application packet with track-job (cover, why-fit, form-answers)
# GENERATE_PACKET=prompt

# Gmail inbox (node check-inbox.js)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_INBOX_QUERY=is:unread (interview OR application OR recruiter)
# GMAIL_MAX_MESSAGES=5
# GMAIL_POLL_MINUTES=5
# INBOX_APPEND_NOTION=0
# NOTION_INBOX_STATUSES=Applied,Interview
# NOTION_INBOX_DAYS=60

# Tailored resume (Markdown + DOCX)
# MASTER_PROFILE_PATH=resume/master-profile.md
# RESUME_OUTPUT_DIR=output
# GENERATE_RESUME=prompt
#   prompt (default) = ask y/n after Notion | yes/1/always = generate without asking | no/0/never = skip
# PROFILE_GAP_CHECK=prompt
#   Before tailoring: prompt = ask y/n to run job-vs-profile gap questions (extra LLM call) | yes/1/always = always | no/0/never = skip
# TAILOR_RESUME_MODEL=
# TAILOR_RESUME_MAX_TOKENS=8192
# Optional sampling for resume JSON only (omit = provider default). Try 0.55–0.75 for slightly less uniform phrasing; higher can risk malformed JSON (retries help).
# TAILOR_TEMPERATURE=
# REVISE_TEMPERATURE=
# TAILOR_TOP_P=
# REVISE_TOP_P=
# Retries when the model returns non-JSON or invalid JSON (default 2 → up to 3 attempts).
# TAILOR_JSON_MAX_RETRIES=2
# LLM_JOB_MODEL=
# LLM_JOB_MAX_TOKENS=1536
# RESUME_STRICT=0
#   When 1, fail if tone/grounding/relevance still fail after optional auto-revision.
# RESUME_AUTO_REVISE=1
#   When 1 (default), run one extra LLM pass if validation suggests revision (tone, overlap, etc.).
# MASTER_PROFILE_MIN_CHARS=200
